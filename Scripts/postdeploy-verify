        #!/usr/bin/env bash
        set -euo pipefail

        test -n "${VERIFY_BASE_URL:-}" || {
          echo "VERIFY_BASE_URL is required" >&2
          exit 1
        }

        TIMEOUT_SECONDS="${VERIFY_TIMEOUT_SECONDS:-900}"
        POLL_SECONDS="${VERIFY_POLL_SECONDS:-5}"
        VERIFY_RUN_MODE="${VERIFY_RUN_MODE:-deploy}"
        VERIFY_MANIFEST_PATH="${VERIFY_MANIFEST_PATH:-ops/manifest.json}"
        SMOKE_PATHS="${VERIFY_SMOKE_PATHS:-/}"
        EXPECTED_CSP="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; upgrade-insecure-requests"
        EXPECTED_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=(), browsing-topics=()"

        header_value() {
          local name="$1"
          python3 -c 'import sys
target = sys.argv[1].lower()
for line in sys.stdin:
    if ":" not in line:
        continue
    name, value = line.split(":", 1)
    if name.strip().lower() == target:
        print(value.strip(), end="")
        break
' "$name"
        }

        assert_header() {
          local path="$1"
          local header="$2"
          local expected="$3"
          local url="${VERIFY_BASE_URL%/}${path}"
          local headers
          local observed

          headers="$(curl -fsSL -o /dev/null -D - "$url" | tr -d '\r')"
          observed="$(printf '%s' "$headers" | header_value "$header")"

          if [ "$observed" != "$expected" ]; then
            echo "Unexpected ${header} at ${url}" >&2
            echo "Expected: ${expected}" >&2
            echo "Observed: ${observed:-<missing>}" >&2
            exit 1
          fi
        }

        manifest_sha_path() {
          if [ -f "$VERIFY_MANIFEST_PATH" ]; then
            python3 - "$VERIFY_MANIFEST_PATH" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as fh:
    data = json.load(fh)

verification = data.get("verification") or {}
print(
    verification.get("release_identity", {}).get("reported_git_sha_path")
    or verification.get("liveness_path")
    or data.get("healthcheck_path")
    or "/up",
    end=""
)
PY
          else
            printf '/up'
          fi
        }

        manifest_required_http_checks() {
          [ -f "$VERIFY_MANIFEST_PATH" ] || return 0

          python3 - "$VERIFY_MANIFEST_PATH" "$VERIFY_RUN_MODE" <<'PY'
import json
import sys

manifest_path, run_mode = sys.argv[1:3]

with open(manifest_path, encoding="utf-8") as fh:
    data = json.load(fh)

checks = ((data.get("verification") or {}).get("checks") or [])
for check in checks:
    if not isinstance(check, dict):
        raise SystemExit("verification.checks entries must be objects")
    if check.get("policy") != "required":
        continue

    runs_on = check.get("runs_on") or []
    if run_mode not in runs_on:
        continue

    kind = check.get("kind")
    name = check.get("name") or "unnamed_check"
    if kind != "http":
        raise SystemExit(f"unsupported required verification kind for generic verifier: {kind or 'missing'} ({name})")

    path = check.get("path")
    if not isinstance(path, str) or not path.startswith("/"):
        raise SystemExit(f"invalid verification path for {name}")

    try:
        expect_status = int(check.get("expect_status"))
    except (TypeError, ValueError):
        raise SystemExit(f"invalid expect_status for {name}")
    if expect_status <= 0:
        raise SystemExit(f"invalid expect_status for {name}")

    timeout_ms = check.get("timeout_ms") or 3000
    try:
        timeout_ms = int(timeout_ms)
    except (TypeError, ValueError):
        raise SystemExit(f"invalid timeout_ms for {name}")
    if timeout_ms <= 0:
        raise SystemExit(f"invalid timeout_ms for {name}")

    print(f"{name}	{path}	{expect_status}	{timeout_ms}")
PY
        }

        http_status() {
          local url="$1"
          local timeout_ms="$2"
          local timeout_seconds=$(( (timeout_ms + 999) / 1000 ))
          if [ "$timeout_seconds" -lt 1 ]; then
            timeout_seconds=1
          fi

          curl -sS -o /dev/null -w '%{http_code}' --max-time "$timeout_seconds" "$url"
        }

        run_http_check() {
          local name="$1"
          local path="$2"
          local expect_status="$3"
          local timeout_ms="$4"
          local url="${VERIFY_BASE_URL%/}${path}"
          local observed_status

          observed_status="$(http_status "$url" "$timeout_ms")"
          if [ "$observed_status" != "$expect_status" ]; then
            echo "Verification check failed: ${name} ${url} expected ${expect_status}, got ${observed_status}" >&2
            exit 1
          fi
        }

        HEALTH_PATH="$(manifest_sha_path)"

        # When EXPECTED_GIT_SHA is set, poll the declared release-truth path for a JSON response containing the SHA.
        # When unset (e.g. Radicchio static sites), just verify the site responds with 200.
        if [ -n "${EXPECTED_GIT_SHA:-}" ]; then
          HEALTH_URL="${VERIFY_BASE_URL%/}${HEALTH_PATH}"
          deadline=$((SECONDS + TIMEOUT_SECONDS))
          matched=0

          parse_git_sha() {
            python3 -c 'import json, sys; data = json.load(sys.stdin); print(data.get("git_sha", ""), end="")' 2>/dev/null || true
          }

          while [ "$SECONDS" -lt "$deadline" ]; do
            body="$(curl -fsS "$HEALTH_URL" 2>/dev/null || true)"
            sha=""

            if [ -n "$body" ]; then
              sha="$(printf '%s' "$body" | parse_git_sha)"
            fi

            if [ "$sha" = "$EXPECTED_GIT_SHA" ]; then
              matched=$((matched + 1))
              if [ "$matched" -ge 2 ]; then
                break
              fi
            else
              matched=0
            fi

            sleep "$POLL_SECONDS"
          done

          if [ "$matched" -lt 2 ]; then
            echo "Timed out waiting for $HEALTH_URL to report git_sha=$EXPECTED_GIT_SHA" >&2
            exit 1
          fi
        else
          # Static site: poll until the root URL returns HTTP 200
          deadline=$((SECONDS + 60))
          while [ "$SECONDS" -lt "$deadline" ]; do
            if curl -fsS -o /dev/null "${VERIFY_BASE_URL%/}/" 2>/dev/null; then
              break
            fi
            sleep "$POLL_SECONDS"
          done
          curl -fsS -o /dev/null "${VERIFY_BASE_URL%/}/" || {
            echo "Site unreachable at ${VERIFY_BASE_URL}" >&2
            exit 1
          }
        fi

        manifest_checks="$(manifest_required_http_checks)"
        if [ -n "$manifest_checks" ]; then
          while IFS=$'	' read -r name path expect_status timeout_ms; do
            test -n "$name" || continue
            run_http_check "$name" "$path" "$expect_status" "$timeout_ms"
          done <<< "$manifest_checks"
        else
          OLDIFS="$IFS"
          IFS=','
          read -r -a paths <<< "$SMOKE_PATHS"
          IFS="$OLDIFS"

          for path in "${paths[@]}"; do
            test -n "$path" || continue
            run_http_check "$path" "$path" "200" "3000"
          done
        fi

        assert_header "/" "Content-Security-Policy" "$EXPECTED_CSP"
        assert_header "/" "Strict-Transport-Security" "max-age=31536000; includeSubDomains"
        assert_header "/" "X-Content-Type-Options" "nosniff"
        assert_header "/" "X-Frame-Options" "DENY"
        assert_header "/" "Referrer-Policy" "strict-origin-when-cross-origin"
        assert_header "/" "Permissions-Policy" "$EXPECTED_PERMISSIONS_POLICY"

        echo "Verified ${VERIFY_BASE_URL}"
